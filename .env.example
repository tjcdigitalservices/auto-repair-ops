# Supabase (required) — Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Optional alias if your dashboard only shows a publishable key:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Tenant routing (optional for local dev)
# NEXT_PUBLIC_DEFAULT_TENANT_SLUG=legacy
# NEXT_PUBLIC_ROOT_DOMAIN=example.com

# Dev server / LAN testing (optional)
# PORT=3000
# NEXT_PUBLIC_DEV_ORIGIN=192.168.0.100:3000
# DEV_ALLOWED_ORIGINS=192.168.0.100:3000

# Mapbox (optional — maps features)
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
